@using System.Net.Http.Json
@inject HttpClient Http
@page "/buses/add"
@using BusReservation.Client.Models
@inject NavigationManager Navigation

<PageTitle>Add Bus</PageTitle>

<h1>Add Bus</h1>

<p>Enter the details of the new bus.</p>

<EditForm Model="@bus" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Bus Number</label>
        <InputText class="form-control" @bind-Value="bus.BusNumber" />
        <ValidationMessage For="@(() => bus.BusNumber)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Bus Name</label>
        <InputText class="form-control" @bind-Value="bus.BusName" />
        <ValidationMessage For="@(() => bus.BusName)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Bus Type</label>
        <InputSelect class="form-select" @bind-Value="bus.BusType">
            <option value="">Select bus type</option>
            <option value="Normal">Normal</option>
            <option value="Deluxe">Deluxe</option>
            <option value="AC">AC</option>
            <option value="Electric">Electric</option>
        </InputSelect>
        <ValidationMessage For="@(() => bus.BusType)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Total Seats</label>
        <InputNumber class="form-control" @bind-Value="bus.TotalSeats" />
        <ValidationMessage For="@(() => bus.TotalSeats)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <InputSelect class="form-select" @bind-Value="bus.Status">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary me-2">
        Save Bus
    </button>

    <button type="button"
            class="btn btn-secondary"
            @onclick="Cancel">
        Cancel
    </button>
</EditForm>

@code {
    private Bus bus = new();

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/bus", bus);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/buses");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/buses");
    }
}